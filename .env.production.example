# ==============================================================================
# CONNECTLY — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (SUPABASE STACK)
# ==============================================================================
# Canonical production environment variables for CONNECTLY running 100% on:
# - Supabase Cloud (PostgreSQL + Private Storage Bucket)
# - LiveKit Cloud (WebRTC SFU)
# - Koyeb / Render Web Service (Backend API + Socket.IO + Signal Gateway)
# - Cloudflare Pages (Frontend) + Cloudflare Worker Proxy (Single-Origin HTTPS)
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit real credentials, service role keys, or private keys to git.
# 2. Configure these directly in your hosting dashboards (Koyeb/Render/Cloudflare).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (Koyeb / Render Web Service)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Client Web Origin (Single-Origin Public Worker URL — MUST use https://)
CLIENT_ORIGIN=https://connectly.example.com

# Reverse Proxy Trust Boundary ("2" for Cloudflare Worker -> Koyeb/Render Edge)
TRUST_PROXY=2

# Worker-to-Backend Origin Authentication Secret (64 hex chars: openssl rand -hex 32)
PROXY_SECRET=REPLACE_WITH_HIGH_ENTROPY_64_HEX_SECRET_DO_NOT_COMMIT

# Supabase Cloud Database & Storage (PostgreSQL ACID + Private Object Storage)
DB_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=connectly-files
REQUIRE_TRANSACTIONS=true

# Cryptographic Token Secrets (Must be high-entropy, >= 32 characters)
JWT_ACCESS_SECRET=REPLACE_WITH_HIGH_ENTROPY_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_HIGH_ENTROPY_REFRESH_SECRET_MIN_32_CHARS

# Envelope Encryption Key (256-bit AES-GCM Key — 64 hex chars: openssl rand -hex 32)
CONNECTLY_ENCRYPTION_KEY_V1=REPLACE_WITH_HIGH_ENTROPY_64_HEX_ENCRYPTION_KEY

# Argon2id Password Hashing Parameters
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# LiveKit Cloud SFU Configuration (Server-side only; NEVER expose secret to client)
LIVEKIT_URL=wss://example-project.livekit.cloud
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET_MIN_32_CHARS
LIVEKIT_SIGNAL_GATEWAY_ENABLED=auto
LIVEKIT_TOKEN_TTL_SECONDS=600

# Socket.IO Scaling Mode:
# - Zero-budget single instance: SOCKET_IO_MULTI_INSTANCE=false (no Redis needed)
# - Multi-instance with Upstash Redis: REDIS_URL=rediss://... + SOCKET_IO_ADAPTER=redis
SOCKET_IO_MULTI_INSTANCE=false
SOCKET_IO_ADAPTER=auto
REDIS_URL=
REDIS_SOCKET_PREFIX=connectly:socketio

# File Sharing Powered by Supabase Storage (Private Bucket)
ENABLE_FILE_SHARING=true
STORAGE_PROVIDER=supabase
STORAGE_MAX_FILE_SIZE_BYTES=26214400
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Cloudflare Pages Build Environment)
# ------------------------------------------------------------------------------
VITE_APP_NAME=Connectly
VITE_APP_URL=https://connectly.example.com
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_IO_URL=/
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_LIVEKIT_URL=wss://example-project.livekit.cloud
VITE_LIVEKIT_WS_URL=wss://example-project.livekit.cloud
VITE_ENABLE_VIRTUAL_BACKGROUND=false
VITE_ENABLE_WHITEBOARD=true
VITE_ENABLE_FILE_SHARING=true

# ------------------------------------------------------------------------------
# 3. SINGLE-ORIGIN REVERSE PROXY CONFIGURATION (Cloudflare Worker Environment)
# ------------------------------------------------------------------------------
BACKEND_ORIGIN=https://connectly-backend.koyeb.app
FRONTEND_ORIGIN=https://connectly-frontend.pages.dev
# Configure via: npx wrangler secret put PROXY_SECRET (exact same 64-hex secret as backend)
PROXY_SECRET=REPLACE_WITH_HIGH_ENTROPY_64_HEX_SECRET_DO_NOT_COMMIT
