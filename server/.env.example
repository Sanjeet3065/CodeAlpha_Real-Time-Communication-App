# CONNECTLY Backend Environment Variables
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/connectly
JWT_ACCESS_SECRET=change_this_to_a_secure_random_string_in_production_min_32_chars
JWT_REFRESH_SECRET=change_this_to_a_secure_random_string_in_production_min_32_chars
CLIENT_ORIGIN=http://localhost:5173

# Argon2id Parameters (Defaults: 64MB memory, 3 iterations, 1 parallelism)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Phase 09 — LiveKit SFU Configuration (Server-Side Only — NEVER expose secrets to frontend)
# For LiveKit Cloud: wss://<your-project>.livekit.cloud
# For self-hosted LiveKit (private/loopback upstream): ws://127.0.0.1:7880
LIVEKIT_URL=ws://127.0.0.1:7880
# Optional public signaling URL returned to browsers (e.g. wss://api.connectly.app/livekit-signal)
# When omitted with LIVEKIT_SIGNAL_GATEWAY_ENABLED=auto, self-hosted deployments automatically route
# browser signaling through CONNECTLY's authoritative /livekit-signal admission gateway.
LIVEKIT_PUBLIC_URL=
LIVEKIT_SIGNAL_GATEWAY_ENABLED=auto
LIVEKIT_API_KEY=replace_with_your_livekit_api_key
LIVEKIT_API_SECRET=replace_with_your_livekit_api_secret
LIVEKIT_TOKEN_TTL_SECONDS=600

# Phase 09 — Multi-Instance Socket.IO Shared Adapter (Fail-Closed in Production / Multi-Instance)
# Preferred production adapter: SOCKET_IO_ADAPTER=redis with REDIS_URL=rediss://...
# (In NODE_ENV=production, non-loopback REDIS_URL must use rediss://; plaintext redis:// is permitted only for loopback 127.0.0.1/localhost/::1.)
# Alternative MongoDB capped-collection adapter: SOCKET_IO_ADAPTER=mongo
# In-memory adapter is permitted ONLY in single-instance non-production development/test.
SOCKET_IO_ADAPTER=auto
SOCKET_IO_MULTI_INSTANCE=auto
REDIS_URL=
REDIS_SOCKET_PREFIX=connectly:socketio
SOCKET_IO_MONGO_COLLECTION=socket_io_adapter_events

# Phase 13 — Private Object Storage Configuration
# Storage Provider: s3 (Production), local (Development fallback), memory (Tests)
STORAGE_PROVIDER=local
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=connectly-files
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_LOCAL_DIR=uploads
STORAGE_MAX_FILE_SIZE_BYTES=26214400
STORAGE_SIGNED_URL_TTL_SECONDS=900
