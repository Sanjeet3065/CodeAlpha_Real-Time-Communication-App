# CONNECTLY — Frontend Environment Configuration
# Copy this file to .env.local for local frontend development.
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the client bundle.
# Never place SUPABASE_SERVICE_ROLE_KEY, API secrets, or private keys here.

# ==============================================================================
# Client Application Configuration (Public)
# ==============================================================================
VITE_APP_NAME="Connectly"
VITE_APP_URL="http://localhost:5173"
VITE_API_BASE_URL="/api/v1"

# ==============================================================================
# Supabase Public Configuration (Optional client reference — API goes via backend)
# ==============================================================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# ==============================================================================
# Real-Time Service Endpoints (Public Endpoints)
# ==============================================================================
# LiveKit SFU WebSocket signaling URL (Public client endpoint, authenticated via short-lived server tokens)
# NEVER place LIVEKIT_API_KEY or LIVEKIT_API_SECRET in VITE_ variables.
VITE_LIVEKIT_URL="ws://127.0.0.1:7880"
VITE_LIVEKIT_WS_URL="ws://127.0.0.1:7880"

# Socket.IO Server URL (Public client endpoint, authenticated via tokens)
VITE_SOCKET_IO_URL="http://localhost:5000"

# ==============================================================================
# Feature Flags (Client-Side)
# ==============================================================================
VITE_ENABLE_VIRTUAL_BACKGROUND="false"
VITE_ENABLE_WHITEBOARD="true"
VITE_ENABLE_FILE_SHARING="true"
VITE_GOOGLE_CLIENT_ID=""
