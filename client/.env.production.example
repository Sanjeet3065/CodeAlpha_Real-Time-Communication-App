# =================================================================
# CONNECTLY CLIENT — Production Environment Variables Template
# Phase 18: Zero-Budget Deployment Foundation
# =================================================================

# Base URL for API requests.
# Under a single-origin reverse proxy, relative '/api/v1' routes directly to the proxy.
VITE_API_BASE_URL=/api/v1

# Real-time WebSocket connection URL.
# Supports both VITE_SOCKET_URL and VITE_SOCKET_IO_URL aliases.
# Under a single-origin reverse proxy, defaults to window.location.origin if omitted.
VITE_SOCKET_URL=https://connectly.yourdomain.com
VITE_SOCKET_IO_URL=https://connectly.yourdomain.com

# File Sharing Feature Gate (Option 2B: Disabled Mode)
# Set to 'false' to completely hide the Files panel and sidebar navigation.
VITE_ENABLE_FILE_SHARING=false
