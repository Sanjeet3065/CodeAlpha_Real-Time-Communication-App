# =================================================================
# CONNECTLY CLIENT — Production Environment Variables (Supabase Stack)
# =================================================================

# Base URL for API requests under Cloudflare Worker single-origin reverse proxy
VITE_API_BASE_URL=/api/v1

# Real-time WebSocket connection URL
VITE_SOCKET_URL=/
VITE_SOCKET_IO_URL=/

# Supabase Public Project Reference (never put SERVICE_ROLE key here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# File Sharing Feature Gate (Powered by Supabase Storage private bucket)
VITE_ENABLE_FILE_SHARING=true
VITE_ENABLE_WHITEBOARD=true
VITE_ENABLE_VIRTUAL_BACKGROUND=false
